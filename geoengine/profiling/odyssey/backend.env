# Apply to an instrumented build; takes effect after the deployment rolls out.
GEOENGINE__OPEN_TELEMETRY__ENABLED=true
GEOENGINE__OPEN_TELEMETRY__ENDPOINT=http://geoengine-edv-staging-jaeger:4317
GEOENGINE__GDAL_PROCESS_POOL__WORKER__OPEN_TELEMETRY__ENABLED=true
GEOENGINE__GDAL_PROCESS_POOL__WORKER__OPEN_TELEMETRY__ENDPOINT=http://geoengine-edv-staging-jaeger:4317
GEOENGINE__LOGGING__LOG_SPEC=info,geoengine_services::api::handlers::ogc=debug,geoengine_services::datasets::external::stac=debug,geoengine_services::util::retry=debug,geoengine_operators::adapters::raster_subquery=debug,geoengine_operators::source::gdal_worker_process=debug,geoengine_operators::cache=debug,geoengine_operators::util=debug
GEOENGINE__GDAL_PROCESS_POOL__WORKER__LOGGING__LOG_SPEC=info,gdalsource_process=debug,geoengine_operators::source::gdal_worker_process=debug
# Current names: the basic-3 image's max_processes/global_active_worker/worker_per_dataset are obsolete.
GEOENGINE__GDAL_PROCESS_POOL__NUMBER_OF_PROCESSES=32
GEOENGINE__GDAL_PROCESS_POOL__MAX_ACTIVE_PROCESSES=16
GEOENGINE__GDAL_PROCESS_POOL__MAX_DATASET_PROCESSES=8
HOTPATH_OUTPUT_FORMAT=json
HOTPATH_OUTPUT_PATH=/tmp/geoengine-hotpath-server.json
HOTPATH_REPORT=functions-timing,threads
HOTPATH_FUNCTIONS_LIMIT=0
HOTPATH_METRICS_PORT=6770
